{
  "manifestVersion": 5,
  "id": "com.salmonslab.legionfill",
  "name": "Legion Fill",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "24.2.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "legionFillPanel",
      "label": { "default": "Legion Fill" },
      "minimumSize": { "width": 260, "height": 400 },
      "preferredDockedSize": { "width": 300, "height": 640 },
      "preferredFloatingSize": { "width": 320, "height": 680 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "localFileSystem": "plugin",
    "allowCodeGenerationFromStrings": false
  }
}
